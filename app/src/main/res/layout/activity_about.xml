<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="About"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageProfile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="Student photo"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_photo" />

        <TextView
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="MUHAMMAD SYAHMI BIN SAMARUDIN"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Student ID: 2024664214" />

        <TextView
            android:id="@+id/textCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ICT602 : Mobile Technology and Development" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="About this app"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Electricity Bill Estimator calculates monthly electricity bill from the units used (kWh) using block rates, applies a rebate of 0 - 5%, and saves each result on your phone so you can view, edit or delete it later." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="How to use"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. On the main page, select the month.\n2. Enter the electricity used in kWh (1 - 1000).\n3. Drag the slider to set the rebate (0 - 5%).\n4. Tap CALCULATE to see the total charges and the final cost after rebate.\n5. Tap SAVE to store the result on your phone.\n6. Tap VIEW HISTORY to see all saved bills (month and final cost).\n7. Tap any bill to see its full details.\n8. On the details page, tap EDIT to change the month, units or rebate, or DELETE to remove the record.\n9. Tap RESET to clear the main form." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Website"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="https://github.com/HanShio"
            android:textColor="#1A73E8" />

        <!-- COPYRIGHT -->
        <TextView
            android:id="@+id/textCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="© 2026 Syahmi. All rights reserved."
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Back" />
    </LinearLayout>
</ScrollView>